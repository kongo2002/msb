DEFAULT_IMAGE_TAG = "msb-base:latest"

# Statuses of a same-named leftover sandbox we can safely reconnect to instead
# of tearing down and recreating from scratch.
RESUMABLE_STATUSES = frozenset(
    {SandboxStatus.RUNNING, SandboxStatus.PAUSED, SandboxStatus.STOPPED}
)

KEEP_ALIVE_MARKER = "/home/msb/.ai-keep-alive"
BASE_SHA_FILE = "/home/msb/.ai-sandbox-base-sha"

# Domains needed regardless of which AI CLI profile or stack is active.
BASE_DOMAINS = [
    # GitHub - repo access, OAuth device login, tarballs/CDN (e.g. uv-managed tool downloads).
    "github.com",
    "codeload.github.com",
    "objects.githubusercontent.com",
]


