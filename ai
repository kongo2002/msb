@dataclass(frozen=True)
class Stack:
    name: str
    mounts: tuple[
        tuple[str, str], ...
    ]  # (host path rel to $HOME, absolute sandbox path)
    extra_domains: tuple[str, ...] = ()


STACKS: dict[str, Stack] = {
    "dotnet": Stack(
        "dotnet",
        ((".nuget/packages", "/home/msb/.nuget/packages"),),
        extra_domains=(
            "api.nuget.org",
            "globalcdn.nuget.org",
