async def append_memory_instructions(sandbox: Sandbox, rel_path: str) -> None:
    """Appends MEMORY_INSTRUCTIONS to a dedicated file in a profile's
    instructions directory in-sandbox (idempotent - a resumed/keep-alive
    sandbox must not duplicate the text)."""
    dst = f"/home/msb/{rel_path}"
    quoted_dst = shlex.quote(dst)
    target = f"{dst}/memory.instructions.md"
    quoted_target = shlex.quote(target)
    quoted_text = shlex.quote(MEMORY_INSTRUCTIONS)
    cmd = (
        f"mkdir -p {quoted_dst} && touch {quoted_target} && "
        f"{{ grep -qF {quoted_text} {quoted_target} || "
        f"printf '\\n%s\\n' {quoted_text} >> {quoted_target}; }}"
    )
    result = await sandbox.exec("sh", ["-c", cmd])
    check_result(result, f"append memory instructions to {dst}")


def build_memory_volume(profile: "Profile") -> dict[str, object]:
    host_path = os.path.expanduser(f"~/.msb/memory/{profile.name}")
    os.makedirs(host_path, exist_ok=True)
    return {MEMORY_SANDBOX_PATH: Volume.bind(host_path)}


def build_context_repo_volume(raw_path: str) -> tuple[str, dict[str, object]]:
    host_path = os.path.abspath(os.path.expanduser(raw_path))
    if not os.path.isdir(host_path):
        raise FatalError(
            f"context repo path does not exist or is not a directory: {raw_path}"
        )
    if not os.path.exists(os.path.join(host_path, ".git")):
        raise FatalError(
            f"context repo path is not a git repository (no .git found): {raw_path}"
        )
    sandbox_path = f"/home/msb/context/{os.path.basename(host_path)}"
    return sandbox_path, {sandbox_path: Volume.bind(host_path, readonly=True)}


def host_git_identity() -> tuple[str | None, str | None]:
    def get(key: str) -> str | None:
        result = run_host(["git", "config", key])
        return result.stdout.strip() or None

    return get("user.name"), get("user.email")


def create_worktree(
    workdir: str, base_sha: str, branch: str, profile: Profile
) -> tuple[str, bool]:
    """Returns (worktree_path, created). A worktree left behind by a prior
    keep-alive round is reused (created=False) so already-transplanted commits
    aren't lost."""
    repo_name = os.path.basename(os.path.normpath(workdir))
    worktree_path = f"/tmp/{profile.name}/{repo_name}-{branch}"
    if os.path.isdir(worktree_path):
        return worktree_path, False
    result = run_host(
        ["git", "worktree", "add", "-b", branch, worktree_path, base_sha], workdir
    )
    check_process(result, "create worktree")
    return worktree_path, True


async def collect_sandbox_bundle(
    sandbox: Sandbox, cwd: str, base_sha: str, wip_commit_message: str
) -> bytes | None:
    """Commits any leftover dirty state in the sandbox, then bundles every
    commit made since base_sha for the host. Returns None if nothing changed."""
    status = await sandbox.exec("git", ["status", "--porcelain"], cwd=cwd)
    if status.stdout_text.strip():
        result = await sandbox.exec("git", ["add", "-A"], cwd=cwd)
        check_result(result, "stage sandbox changes")
        result = await sandbox.exec(
            "git", ["commit", "-m", wip_commit_message], cwd=cwd
        )
        check_result(result, "commit sandbox changes")

    count_result = await sandbox.exec(
        "git", ["rev-list", "--count", f"{base_sha}..HEAD"], cwd=cwd
    )
    check_result(count_result, "inspect sandbox history")
    if int(count_result.stdout_text.strip() or "0") == 0:
        return None

    bundle_result = await sandbox.exec(
        "git", ["bundle", "create", "-", f"{base_sha}..HEAD"], cwd=cwd
    )
    check_result(bundle_result, "bundle sandbox commits")
    return bundle_result.stdout_bytes


def apply_bundle_to_worktree(worktree_path: str, bundle: bytes, base_sha: str) -> None:
    """Brings the bundled commits onto the worktree branch: a fast-forward if
    the branch still sits at base_sha (keeping the sandbox shas), otherwise a
    cherry-pick on top of the branch tip. A conflicting cherry-pick is left in
    progress for the user to resolve."""
    fd, bundle_path = tempfile.mkstemp(suffix=".bundle", prefix="ai-sandbox-")
    with os.fdopen(fd, "wb") as f:
        f.write(bundle)

    def fail(step: str, detail: str) -> FatalError:
        return FatalError(
            f"{step} failed: {detail.strip()}\n"
            f"sandbox commits preserved at {bundle_path}\n"
            f"  inspect:  git fetch {shlex.quote(bundle_path)} HEAD\n"
            "            git log --oneline FETCH_HEAD\n"
            f"  keep:     git fetch {shlex.quote(bundle_path)} HEAD:refs/heads/<name>\n"
            "  pick:     git cherry-pick <sha>"
        )

    result = run_host(["git", "fetch", "--quiet", bundle_path, "HEAD"], worktree_path)
    if result.returncode != 0:
        raise fail("fetching sandbox bundle", result.stderr)
    tip = resolve_ref(worktree_path, "FETCH_HEAD")

    if resolve_ref(worktree_path, "HEAD") == base_sha:
        result = run_host(["git", "merge", "--ff-only", tip], worktree_path)
        step = "fast-forward"
    else:
        result = run_host(["git", "cherry-pick", f"{base_sha}..{tip}"], worktree_path)
        step = (
            "cherry-pick onto worktree tip (resolve, then `git cherry-pick --continue`)"
        )
    if result.returncode != 0:
        raise fail(step, result.stderr or result.stdout)
    os.unlink(bundle_path)


def remove_empty_worktree(workdir: str, worktree_path: str, branch: str) -> None:
    result = run_host(["git", "worktree", "remove", "--force", worktree_path], workdir)
    if result.returncode != 0:
        print(
            f"warning: failed to remove empty worktree {worktree_path}: {result.stderr}",
            file=sys.stderr,
        )
        return
    result = run_host(["git", "branch", "-D", branch], workdir)
    if result.returncode != 0:
        print(
            f"warning: failed to delete empty branch {branch}: {result.stderr}",
            file=sys.stderr,
        )


def sandbox_name_for(path: str, profile_name: str, branch: str) -> str:
    digest = hashlib.sha256(f"{os.path.abspath(path)}:{branch}".encode()).hexdigest()[
        :10
    ]
    return f"{profile_name}-{digest}"


def build_network(
    profile_extra_domains: tuple[str, ...], user_extra_domains: tuple[str, ...] = ()
) -> Network:
    rules = list(Rule.allow_dns())
    all_domains = (*BASE_DOMAINS, *profile_extra_domains, *user_extra_domains)
    for domain in dict.fromkeys(all_domains):
        rules.append(Rule.allow(destination=Destination.domain(domain), port=443))
    return Network(policy=NetworkPolicy(default_egress=Action.DENY, rules=tuple(rules)))


@dataclass(frozen=True)
class Settings:
    branch: str
    profile: Profile
    target_branch: str
    stack_names: frozenset[str]
    context_path: str | None
    use_memory: bool
    verbose: bool
    token: str = field(repr=False)
    image: str
    cpus: int
    memory_mib: int
    extra_domains: tuple[str, ...]
    docker_images: tuple[str, ...]


def split_csv(raw: str) -> list[str]:
    return [item.strip() for item in raw.split(",") if item.strip()]


def parse_settings() -> Settings:
    """Single place that reads CLI arguments and environment variables."""
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "branch",
        help="branch name for the worktree that captures the sandbox's changes",
    )
    parser.add_argument("--profile", choices=sorted(PROFILES), default="copilot")
    parser.add_argument(
        "--ref", help="reference branch to base the work off of (or set MSB_REFERENCE)"
    )
    parser.add_argument(
        "--stacks",
        default="",
        help=(
            "comma-separated language/framework stacks whose global caches to "
            f"mount from the host (or set MSB_STACKS). choices: {', '.join(sorted(STACKS))}"
        ),
    )
    parser.add_argument(
        "--context",
        help="path to a second, separate host git repo to mount read-only for reference",
    )
    parser.add_argument(
        "--no-memory",
        action="store_true",
        help="disable the persistent cross-project agent memory mount",
    )
    parser.add_argument(
        "--verbose",
        action="store_true",
        help="print sandbox setup/progress steps (quiet by default)",
    )
    args = parser.parse_args()
    profile = PROFILES[args.profile]

    stack_names = frozenset(
        split_csv(f"{args.stacks},{os.environ.get('MSB_STACKS', '')}")
    )
    unknown_stacks = stack_names - STACKS.keys()
    if unknown_stacks:
        raise FatalError(
            f"unknown stack(s): {', '.join(sorted(unknown_stacks))}; "
            f"choices: {', '.join(sorted(STACKS))}"
        )

    token = os.environ.get(profile.token_env)
    if not token:
        raise FatalError(
            f"Set {profile.token_env} in your host shell before running this."
        )

    if not os.path.exists(".git"):
        raise FatalError("Current directory is not a git repository")

    docker_images = tuple(split_csv(os.environ.get("MSB_DOCKER_IMAGES", "")))
    if docker_images and "docker" not in stack_names:
        raise FatalError(
            "MSB_DOCKER_IMAGES requires the docker stack (--stacks docker)"
        )

    return Settings(
        branch=args.branch,
        profile=profile,
        target_branch=args.ref or os.environ.get("MSB_REFERENCE") or "master",
        stack_names=stack_names,
        context_path=args.context,
        use_memory=not args.no_memory,
        verbose=args.verbose,
        token=token,
        image=os.environ.get("MSB_IMAGE", DEFAULT_IMAGE_TAG),
        cpus=env_positive_int("MSB_CPUS", DEFAULT_CPUS),
        memory_mib=env_positive_int("MSB_MEMORY_MIB", DEFAULT_MEMORY_MIB),
        extra_domains=tuple(split_csv(os.environ.get("MSB_EXTRA_DOMAINS", ""))),
        docker_images=docker_images,
    )


def resolve_ref(workdir: str, ref: str) -> str:
    result = run_host(["git", "rev-parse", ref], workdir)
    check_process(result, f"resolve {ref}")
    return result.stdout.strip()


@dataclass(frozen=True)
class HostInputs:
    """Everything the sandbox is built from, gathered on the host up front."""

    target_sha: str
    patches: tuple[object, ...]
    volumes: Mapping[str, object]
    domains: tuple[str, ...]


def prepare_host_inputs(
    settings: Settings, workdir: str, target_workdir: str
) -> HostInputs:
    profile = settings.profile
    config_patches = build_config_patches(profile)
    local_claude_md_patches = build_local_claude_md_patch(workdir, target_workdir)
    volumes, stack_domains = build_stack_volumes(
        set(settings.stack_names), settings.memory_mib
    )
    volumes.update(build_docker_image_volumes(list(settings.docker_images)))

    if settings.use_memory:
        volumes.update(build_memory_volume(profile))

    if settings.context_path:
        context_sandbox_path, context_volume = build_context_repo_volume(
            settings.context_path
        )
        volumes.update(context_volume)
        log(f"> mounting context repo at {context_sandbox_path} (read-only)")

    if local_claude_md_patches:
        log("> mirroring untracked local CLAUDE.md into sandbox")

    return HostInputs(
        target_sha=resolve_ref(workdir, settings.target_branch),
        patches=(
            Patch.copy_dir(src=".git", dst=f"{target_workdir}/.git"),
            *config_patches,
            *local_claude_md_patches,
        ),
        volumes=volumes,
        domains=(*settings.extra_domains, *stack_domains),
    )


async def provision_sandbox(
    settings: Settings, host: HostInputs, sandbox_name: str
) -> tuple[Sandbox, bool]:
    """Creates or resumes the sandbox. Returns (sandbox, resuming)."""
    profile = settings.profile
    try:
        existing = await Sandbox.get(sandbox_name)
        resuming = existing.status in RESUMABLE_STATUSES
    except SandboxNotFoundError:
        resuming = False

    log("> resuming sandbox" if resuming else "> creating sandbox")
    sandbox = await Sandbox.connect_or_create(
        sandbox_name,
        image=settings.image,
        cpus=settings.cpus,
        memory=settings.memory_mib,
        network=build_network(profile.extra_domains, host.domains),
        secrets=[
            Secret.env(
                profile.secret_env,
                value=settings.token,
                allow=list(profile.secret_allow_domains),
            ),
        ],
        patches=host.patches,
        volumes=host.volumes,
    )
    return sandbox, resuming


def build_root_script(
    chown_paths: list[str] | None, stack_names: frozenset[str]
) -> str:
    """One root-side script for ownership fixes (fresh sandboxes only) and the
    stacks' setup. Stack scripts run in subshells since they may `exit`."""
    lines = ["set -e"]
    if chown_paths is not None:
        lines.append("chown 1001:1001 /home/msb")
        lines.extend(f"chown -R 1001:1001 {shlex.quote(p)}" for p in chown_paths)
    for stack_name in sorted(stack_names):
        root_script = STACKS[stack_name].root_script
        if root_script:
            lines.append(f"({root_script}\n)")
    return "\n".join(lines) if len(lines) > 1 else ""


async def exec_root_script(sandbox: Sandbox, script: str, step: str) -> None:
    if not script:
        return
    log(f"> {step}")
    result = await sandbox.exec("sh", ["-c", script], user="root")
    check_result(result, "prepare sandbox as root")


async def prepare_fresh_sandbox(
    sandbox: Sandbox, settings: Settings, host: HostInputs, target_workdir: str
) -> str:
    """Brings a newly created sandbox into a ready state. Returns the base sha."""
    chown_paths = [target_workdir, *profile_state_dirs(settings.profile)]
    await exec_root_script(
        sandbox,
        build_root_script(chown_paths, settings.stack_names),
        "adjust ownership and set up stacks",
    )

    log(
        f"> checking out latest {settings.target_branch} and applying git configuration"
    )
    base_sha = host.target_sha
    name, email = host_git_identity()
    git_script_lines = [
        "set -e",
        f"git reset --hard {shlex.quote(base_sha)}",
        # repoint the current branch to target_branch (HEAD already
        # matches base_sha, so this doesn't touch the working tree)
        # so it matches the reference branch instead of whatever
        # branch happened to be checked out on the host
        f"git checkout -B {shlex.quote(settings.target_branch)}",
        f"echo {shlex.quote(base_sha)} > {shlex.quote(BASE_SHA_FILE)}",
        # clear potential signing configuration (would fail due to missing keys anyways)
        "git config --unset gpg.format || true",
        "git config --unset commit.gpgsign || true",
        # couple of git convenience aliases
        "git config --global alias.br branch",
        "git config --global alias.ci 'commit -v'",
        "git config --global alias.cia 'commit -v --amend'",
        "git config --global alias.co checkout",
        "git config --global alias.df diff",
        "git config --global alias.st 'status --short --branch'",
    ]
    if name:
        git_script_lines.append(f"git config --global user.name {shlex.quote(name)}")
    if email:
        git_script_lines.append(f"git config --global user.email {shlex.quote(email)}")
    result = await sandbox.exec(
        "sh", ["-c", "\n".join(git_script_lines)], cwd=target_workdir
    )
    check_result(result, "prepare sandbox repository")
    return base_sha


async def prepare_resumed_sandbox(sandbox: Sandbox, settings: Settings) -> str:
    """Re-runs the stack setup on a resumed sandbox. Returns the pinned base sha."""
    # base_sha was pinned by the session that provisioned this sandbox;
    # re-resolving target_branch here would drift from what's checked out.
    result = await sandbox.exec("cat", [BASE_SHA_FILE])
    check_result(result, "read pinned base sha from sandbox")
    await exec_root_script(
        sandbox, build_root_script(None, settings.stack_names), "set up stacks"
    )
    return result.stdout_text.strip()


async def run_session(sandbox: Sandbox, settings: Settings, target_workdir: str) -> int:
    """Runs the AI CLI, then an interactive shell. Returns the CLI's exit code."""
    profile = settings.profile
    binary_args = list(profile.binary_args)
    if settings.use_memory:
        if profile.memory_config_path:
            await append_memory_instructions(sandbox, profile.memory_config_path)
        else:
            binary_args = [*binary_args, profile.memory_flag, MEMORY_INSTRUCTIONS]

    log("> dropping into CLI...")
    exit_code = await sandbox.attach(
        profile.binary, binary_args, cwd=target_workdir, env={"COLORTERM": "truecolor"}
    )

    print(
        "> dropping into sandbox shell... (run `keep-alive` instead of `exit` "
        "to keep this sandbox around for further iteration)",
        file=sys.stderr,
    )
    await sandbox.attach("zsh", [], cwd=target_workdir)
    return exit_code


async def consume_keep_alive_marker(sandbox: Sandbox) -> bool:
    marker_check = await sandbox.exec("test", ["-f", KEEP_ALIVE_MARKER])
    if marker_check.exit_code != 0:
        return False
    await sandbox.exec("rm", ["-f", KEEP_ALIVE_MARKER])
    return True


async def repin_base_sha(sandbox: Sandbox, target_workdir: str) -> None:
    """Re-pins so the next round only collects commits made after this transplant."""
    head_result = await sandbox.exec("git", ["rev-parse", "HEAD"], cwd=target_workdir)
    check_result(head_result, "read sandbox HEAD")
    pin_result = await sandbox.exec(
        "sh",
        [
            "-c",
            f"echo {shlex.quote(head_result.stdout_text.strip())} > {shlex.quote(BASE_SHA_FILE)}",
        ],
    )
    check_result(pin_result, "re-pin base sha in sandbox")


async def run(
    settings: Settings, host: HostInputs, workdir: str, target_workdir: str
) -> int:
    sandbox_name = sandbox_name_for(workdir, settings.profile.name, settings.branch)
    sandbox, resuming = await provision_sandbox(settings, host, sandbox_name)

    keep_alive = False
    uncollected = False
    try:
        if resuming:
            base_sha = await prepare_resumed_sandbox(sandbox, settings)
        else:
            base_sha = await prepare_fresh_sandbox(
                sandbox, settings, host, target_workdir
            )

        log(f"> creating worktree for branch {settings.branch}")
        worktree_path, worktree_created = create_worktree(
            workdir, base_sha, settings.branch, settings.profile
        )

        # from here on the sandbox may hold work that exists nowhere else
        uncollected = True
        exit_code = await run_session(sandbox, settings, target_workdir)

        # determined before collecting so a collection failure still keeps the sandbox
        keep_alive = await consume_keep_alive_marker(sandbox)
        bundle = await collect_sandbox_bundle(
            sandbox,
            target_workdir,
            base_sha,
            f"WIP: {settings.profile.name} sandbox session ({settings.branch})",
        )
        uncollected = False
        if keep_alive and bundle is not None:
            await repin_base_sha(sandbox, target_workdir)
    finally:
        if uncollected:
            print(
                f"> session output not collected, sandbox kept as '{sandbox_name}' - "
                "rerun the same command to resume",
                file=sys.stderr,
            )
        elif not keep_alive:
            await sandbox.destroy()

    if bundle is not None:
        apply_bundle_to_worktree(worktree_path, bundle, base_sha)
        print(
            f"> transferred sandbox commits onto {worktree_path} (branch {settings.branch})",
            file=sys.stderr,
        )
    elif worktree_created:
        print(
            "> no changes detected in sandbox, removing empty worktree", file=sys.stderr
        )
        remove_empty_worktree(workdir, worktree_path, settings.branch)
    else:
        print(
            f"> no new changes in sandbox, keeping existing worktree {worktree_path}",
            file=sys.stderr,
        )

    if keep_alive:
        print(
            f"> sandbox left running as '{sandbox_name}' - rerun the same command to resume",
            file=sys.stderr,
        )

    return exit_code


def main() -> None:
    global _verbose
    try:
        settings = parse_settings()
        _verbose = settings.verbose

        workdir = os.getcwd()
        target_workdir = "/home/msb/workspace"
        host = prepare_host_inputs(settings, workdir, target_workdir)
        exit_code = asyncio.run(run(settings, host, workdir, target_workdir))
    except FatalError as e:
        sys.exit(str(e))
    sys.exit(exit_code)


if __name__ == "__main__":
    main()

