def build_config_patches(profile: "Profile") -> tuple[list, list[str]]:
    patches = []
    dsts = []
    for rel_path in profile.config_paths:
        host_path = os.path.expanduser(f"~/{rel_path}")
        if not os.path.exists(host_path):
            continue
        dst = f"/home/msb/{rel_path}"
        if os.path.isdir(host_path):
            patches.append(Patch.copy_dir(src=host_path, dst=dst))
        else:
            patches.append(Patch.copy_file(src=host_path, dst=dst))
        dsts.append(dst)
    return patches, dsts


def build_local_claude_md_patch(workdir: str, target_workdir: str) -> list:
    # only .git is mirrored + checked out via `git reset --hard`, so an
    # untracked (local-only, e.g. gitignored) CLAUDE.md never reaches the
    # sandbox otherwise
    host_path = os.path.join(workdir, "CLAUDE.md")
    if not os.path.isfile(host_path):
        return []
    result = subprocess.run(
        ["git", "ls-files", "--error-unmatch", "CLAUDE.md"],
        cwd=workdir,
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode == 0:
        return []  # tracked - git reset --hard already brings it in
    return [Patch.copy_file(src=host_path, dst=f"{target_workdir}/CLAUDE.md")]


def env_positive_int(name: str, default: int) -> int:
    raw = os.environ.get(name)
    if raw is None or not raw.strip():
        return default
    if not raw.strip().isdigit() or int(raw) < 1:
        sys.exit(f"{name} must be a positive integer, got: {raw!r}")
    return int(raw)


def build_stack_volumes(
    stack_names: set[str], memory_mib: int
) -> tuple[dict[str, object], tuple[str, ...]]:
    volumes: dict[str, object] = {}
    extra_domains: list[str] = []
    for name in sorted(stack_names):
        stack = STACKS[name]
        for host_rel, sandbox_path in stack.mounts:
            host_path = os.path.expanduser(f"~/{host_rel}")
            os.makedirs(host_path, exist_ok=True)
            volumes[sandbox_path] = Volume.bind(host_path)
        for sandbox_path, percent in stack.tmpfs:
            volumes[sandbox_path] = Volume.tmpfs(size_mib=memory_mib * percent // 100)
        extra_domains.extend(stack.extra_domains)
    return volumes, tuple(extra_domains)


def build_docker_image_volumes(images: list[str]) -> dict[str, object]:
    """Exports host docker images as tarballs (cached per image ID) and mounts
    one directory per image, so only the requested images get loaded."""
    volumes: dict[str, object] = {}
    for image in images:
        result = subprocess.run(
            ["docker", "image", "inspect", "--format", "{{.Id}}", image],
            capture_output=True,
            text=True,
            check=False,
        )
        if result.returncode != 0:
            sys.exit(f"docker image not found on host (pull it first): {image}")
        image_id = result.stdout.strip().removeprefix("sha256:")[:12]
        key = re.sub(r"[^A-Za-z0-9_.-]", "_", image)
        host_dir = os.path.expanduser(f"~/.msb/docker-images/{key}")
        tarball = os.path.join(host_dir, f"{image_id}.tar")
        if not os.path.exists(tarball):
            # drops tarballs of outdated image versions
            shutil.rmtree(host_dir, ignore_errors=True)
            os.makedirs(host_dir)
            log(f"> exporting docker image {image}")
            tmp = f"{tarball}.tmp"
            saved = subprocess.run(
                ["docker", "save", "-o", tmp, image],
                capture_output=True,
                text=True,
                check=False,
            )
            if saved.returncode != 0:
                sys.exit(f"failed to export docker image {image}: {saved.stderr}")
            os.rename(tmp, tarball)
        volumes[f"{DOCKER_IMAGES_SANDBOX_PATH}/{key}"] = Volume.bind(
            host_dir, readonly=True
        )
    return volumes


