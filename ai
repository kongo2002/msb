def build_config_patches(profile: "Profile") -> tuple[list, list[str]]:
    patches = []
    dsts = []
    for rel_path in profile.config_paths:
        host_path = os.path.expanduser(f"~/{rel_path}")
        if not os.path.exists(host_path):
            continue
        dst = f"/home/msb/{rel_path}"
        if os.path.isdir(host_path):
            patches.append(Patch.copy_dir(src=host_path, dst=dst))
        else:
            patches.append(Patch.copy_file(src=host_path, dst=dst))
        dsts.append(dst)
    return patches, dsts


def build_local_claude_md_patch(workdir: str, target_workdir: str) -> list:
    # only .git is mirrored + checked out via `git reset --hard`, so an
    # untracked (local-only, e.g. gitignored) CLAUDE.md never reaches the
    # sandbox otherwise
    host_path = os.path.join(workdir, "CLAUDE.md")
    if not os.path.isfile(host_path):
        return []
    result = subprocess.run(
        ["git", "ls-files", "--error-unmatch", "CLAUDE.md"],
        cwd=workdir,
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode == 0:
        return []  # tracked - git reset --hard already brings it in
    return [Patch.copy_file(src=host_path, dst=f"{target_workdir}/CLAUDE.md")]


def build_stack_volumes(
    stack_names: set[str],
) -> tuple[dict[str, object], tuple[str, ...]]:
    volumes: dict[str, object] = {}
    extra_domains: list[str] = []
    for name in sorted(stack_names):
        stack = STACKS[name]
        for host_rel, sandbox_path in stack.mounts:
            host_path = os.path.expanduser(f"~/{host_rel}")
            os.makedirs(host_path, exist_ok=True)
            volumes[sandbox_path] = Volume.bind(host_path)
        extra_domains.extend(stack.extra_domains)
    return volumes, tuple(extra_domains)


MEMORY_SANDBOX_PATH = "/home/msb/.ai-memory"

MEMORY_INSTRUCTIONS = (
    f"You have a persistent, cross-project memory file at {MEMORY_SANDBOX_PATH}/MEMORY.md. "
    "Read it now. When the user gives you a durable, project-independent instruction - a "
    "preference, a correction, a habit that should carry over to future sessions - "
    "append a short bullet to it. Keep entries terse, one bullet per learning. Do not record "
    "anything specific to this project or this task. Ask the user for confirmation before "
    "modifying the file."
)


def build_memory_volume(profile: "Profile") -> dict[str, object]:
    host_path = os.path.expanduser(f"~/.msb/memory/{profile.name}")
    os.makedirs(host_path, exist_ok=True)
    return {MEMORY_SANDBOX_PATH: Volume.bind(host_path)}


def build_context_repo_volume(raw_path: str) -> tuple[str, dict[str, object]]:
    host_path = os.path.abspath(os.path.expanduser(raw_path))
    if not os.path.isdir(host_path):
        sys.exit(f"context repo path does not exist or is not a directory: {raw_path}")
    if not os.path.exists(os.path.join(host_path, ".git")):
        sys.exit(
            f"context repo path is not a git repository (no .git found): {raw_path}"
        )
    sandbox_path = f"/home/msb/context/{os.path.basename(host_path)}"
    return sandbox_path, {sandbox_path: Volume.bind(host_path, readonly=True)}


def host_git_identity() -> tuple[str | None, str | None]:
    def get(key: str) -> str | None:
        result = subprocess.run(
            ["git", "config", key], capture_output=True, text=True, check=False
        )
        return result.stdout.strip() or None

    return get("user.name"), get("user.email")


def create_worktree(workdir: str, base_sha: str, branch: str) -> str:
    repo_name = os.path.basename(os.path.normpath(workdir))
    worktree_path = f"/tmp/claude/{repo_name}-{branch}"
    if os.path.isdir(worktree_path):
        # left behind by a prior keep-alive round for this branch - reuse it
        # so already-transplanted commits aren't lost.
        return worktree_path
    result = subprocess.run(
        ["git", "worktree", "add", "-b", branch, worktree_path, base_sha],
        cwd=workdir,
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        sys.exit(f"failed to create worktree: {result.stderr}")
    return worktree_path


async def collect_sandbox_patches(
    sandbox: Sandbox, cwd: str, base_sha: str, wip_commit_message: str
) -> str | None:
    """Commits any leftover dirty state in the sandbox, then formats every
    commit made since base_sha (individually) as a patch series for the host.
    Returns None if nothing changed."""
    status = await sandbox.exec("git", ["status", "--porcelain"], cwd=cwd)
    if status.stdout_text.strip():
        result = await sandbox.exec("git", ["add", "-A"], cwd=cwd)
        if result.exit_code != 0:
            sys.exit(f"failed to stage sandbox changes: {result.stderr_text}")
        result = await sandbox.exec(
            "git", ["commit", "-m", wip_commit_message], cwd=cwd
        )
        if result.exit_code != 0:
            sys.exit(f"failed to commit sandbox changes: {result.stderr_text}")

    count_result = await sandbox.exec(
        "git", ["rev-list", "--count", f"{base_sha}..HEAD"], cwd=cwd
    )
    if count_result.exit_code != 0:
        sys.exit(f"failed to inspect sandbox history: {count_result.stderr_text}")
    if int(count_result.stdout_text.strip() or "0") == 0:
        return None

    patch_result = await sandbox.exec(
        "git",
        ["format-patch", "--binary", "--stdout", f"{base_sha}..HEAD"],
        cwd=cwd,
    )
    if patch_result.exit_code != 0:
        sys.exit(f"failed to format sandbox commits: {patch_result.stderr_text}")
    return patch_result.stdout_text


def apply_patches_to_worktree(worktree_path: str, patch_text: str) -> None:
    result = subprocess.run(
        ["git", "am"],
        input=patch_text,
        cwd=worktree_path,
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        subprocess.run(["git", "am", "--abort"], cwd=worktree_path, check=False)
        fd, patch_path = tempfile.mkstemp(suffix=".patch", prefix="ai-sandbox-")
        with os.fdopen(fd, "w") as f:
            f.write(patch_text)
        sys.exit(
            f"git am failed: {result.stderr}\n"
            f"sandbox patches preserved at {patch_path} for manual recovery"
        )


def remove_empty_worktree(workdir: str, worktree_path: str, branch: str) -> None:
    result = subprocess.run(
        ["git", "worktree", "remove", "--force", worktree_path],
        cwd=workdir,
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        print(
            f"warning: failed to remove empty worktree {worktree_path}: {result.stderr}",
            file=sys.stderr,
        )
        return
    result = subprocess.run(
        ["git", "branch", "-D", branch],
        cwd=workdir,
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        print(
            f"warning: failed to delete empty branch {branch}: {result.stderr}",
            file=sys.stderr,
        )


def sandbox_name_for(path: str, profile_name: str, branch: str) -> str:
    digest = hashlib.sha256(f"{os.path.abspath(path)}:{branch}".encode()).hexdigest()[
        :10
    ]
    return f"{profile_name}-{digest}"


async def chown_to_msb(sandbox: Sandbox, path: str, *, recursive: bool = True) -> None:
    args = (["-R"] if recursive else []) + ["1001:1001", path]
    result = await sandbox.exec("chown", args, user="root")
    if result.exit_code != 0:
        sys.exit(f"failed to change ownership of {path}: {result.stderr_text}")


def build_network(
    profile_extra_domains: tuple[str, ...], user_extra_domains: tuple[str, ...] = ()
) -> Network:
    rules = list(Rule.allow_dns())
    for domain in (*BASE_DOMAINS, *profile_extra_domains, *user_extra_domains):
        rules.append(Rule.allow(destination=Destination.domain(domain), port=443))
    return Network(policy=NetworkPolicy(default_egress=Action.DENY, rules=tuple(rules)))


async def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "branch",
        help="branch name for the worktree that captures the sandbox's changes",
    )
    parser.add_argument("--profile", choices=sorted(PROFILES), default="copilot")
    parser.add_argument(
        "--ref", help="reference branch to base the work off of (or set MSB_REFERENCE)"
    )
    parser.add_argument(
        "--stacks",
        default="",
        help=(
            "comma-separated language/framework stacks whose global caches to "
            f"mount from the host (or set MSB_STACKS). choices: {', '.join(sorted(STACKS))}"
        ),
    )
    parser.add_argument(
        "--context",
        help="path to a second, separate host git repo to mount read-only for reference",
    )
    parser.add_argument(
        "--no-memory",
        action="store_true",
        help="disable the persistent cross-project agent memory mount",
    )
    args = parser.parse_args()
    profile = PROFILES[args.profile]
    target_branch = args.ref or os.environ.get("MSB_REFERENCE", None) or "master"

    user_extra_domains = tuple(
        domain.strip()
        for domain in os.environ.get("MSB_EXTRA_DOMAINS", "").split(",")
        if domain.strip()
    )

    stack_names = {
        name.strip()
        for name in f"{args.stacks},{os.environ.get('MSB_STACKS', '')}".split(",")
        if name.strip()
    }
    unknown_stacks = stack_names - STACKS.keys()
    if unknown_stacks:
        sys.exit(
            f"unknown stack(s): {', '.join(sorted(unknown_stacks))}; "
            f"choices: {', '.join(sorted(STACKS))}"
        )

    token = os.environ.get(profile.token_env)
    if not token:
        sys.exit(f"Set {profile.token_env} in your host shell before running this.")

    if not os.path.exists(".git"):
        sys.exit("Current directory is not a git repository")

    workdir = os.getcwd()
    target_workdir = "/home/msb/workspace"
    sandbox_name = sandbox_name_for(workdir, profile.name, args.branch)
    config_patches, config_dsts = build_config_patches(profile)
    local_claude_md_patches = build_local_claude_md_patch(workdir, target_workdir)
    stack_volumes, stack_domains = build_stack_volumes(stack_names)

    if not args.no_memory:
        stack_volumes.update(build_memory_volume(profile))

    context_sandbox_path = None
    if args.context:
        context_sandbox_path, context_volume = build_context_repo_volume(args.context)
        stack_volumes.update(context_volume)

    try:
        existing = await Sandbox.get(sandbox_name)
        resuming = existing.status in RESUMABLE_STATUSES
    except SandboxNotFoundError:
        resuming = False

    if context_sandbox_path:
        print(
            f"> mounting context repo at {context_sandbox_path} (read-only)",
            file=sys.stderr,
        )

    if local_claude_md_patches:
        print("> mirroring untracked local CLAUDE.md into sandbox", file=sys.stderr)

    print("> resuming sandbox" if resuming else "> creating sandbox", file=sys.stderr)
    sandbox = await Sandbox.connect_or_create(
        sandbox_name,
        image=os.environ.get("MSB_IMAGE", DEFAULT_IMAGE_TAG),
        cpus=2,
        memory=2048,
        network=build_network(
            profile.extra_domains, (*user_extra_domains, *stack_domains)
        ),
        secrets=[
            Secret.env(
                profile.secret_env,
                value=token,
                allow=list(profile.secret_allow_domains),
            ),
        ],
        patches=[
            Patch.copy_dir(src=".git", dst=f"{target_workdir}/.git"),
            *config_patches,
            *local_claude_md_patches,
        ],
        volumes=stack_volumes,
    )

    keep_alive = False
    try:
        if resuming:
            # base_sha was pinned by the session that provisioned this sandbox;
            # re-resolving target_branch here would drift from what's checked out.
            result = await sandbox.exec("cat", [BASE_SHA_FILE])
            if result.exit_code != 0:
                sys.exit(f"failed to read pinned base sha from sandbox: {result.stderr_text}")
            base_sha = result.stdout_text.strip()
        else:
            result = subprocess.run(  # noqa: ASYNC221 - one-shot CLI script, no concurrent event loop work
                ["git", "rev-parse", target_branch],
                cwd=workdir,
                capture_output=True,
                text=True,
                check=False,
            )
            if result.returncode != 0:
                sys.exit(f"failed to resolve {target_branch}: {result.stderr}")
            base_sha = result.stdout.strip()

            print("> adjust HOME ownership", file=sys.stderr)
            await chown_to_msb(sandbox, "/home/msb", recursive=False)

            print("> adjust working directory ownership", file=sys.stderr)
            await chown_to_msb(sandbox, target_workdir)

            await chown_to_msb(sandbox, "/home/msb/.claude")
            await chown_to_msb(sandbox, "/home/msb/.copilot")

            for dst in config_dsts:
                await chown_to_msb(sandbox, dst)

            print(f"> checking out latest {target_branch}", file=sys.stderr)
            result = await sandbox.exec(
                "git", ["reset", "--hard", target_branch], cwd=target_workdir
            )
            if result.exit_code != 0:
                sys.exit(f"failed to reset working directory: {result.stderr_text}")

            result = await sandbox.exec(
                "sh", ["-c", f"echo {base_sha} > {BASE_SHA_FILE}"]
            )
            if result.exit_code != 0:
                sys.exit(f"failed to pin base sha in sandbox: {result.stderr_text}")

            print("> applying host git identity", file=sys.stderr)
            name, email = host_git_identity()
            if name:
                result = await sandbox.exec(
                    "git", ["config", "--global", "user.name", name], cwd=target_workdir
                )
                if result.exit_code != 0:
                    sys.exit(f"failed to set git user.name: {result.stderr_text}")
            if email:
                result = await sandbox.exec(
                    "git", ["config", "--global", "user.email", email], cwd=target_workdir
                )
                if result.exit_code != 0:
                    sys.exit(f"failed to set git user.email: {result.stderr_text}")

        print(f"> creating worktree for branch {args.branch}", file=sys.stderr)
        worktree_path = create_worktree(workdir, base_sha, args.branch)

        binary_args = profile.binary_args
        if not args.no_memory:
            binary_args = [*binary_args, profile.memory_flag, MEMORY_INSTRUCTIONS]

        print("> dropping into CLI...", file=sys.stderr)
        exit_code = await sandbox.attach(
            profile.binary, binary_args, cwd=target_workdir
        )

        print(
            "> dropping into sandbox shell... (run `keep-alive` instead of `exit` "
            "to keep this sandbox around for further iteration)",
            file=sys.stderr,
        )
        await sandbox.attach("zsh", [], cwd=target_workdir)

        marker_check = await sandbox.exec("test", ["-f", KEEP_ALIVE_MARKER])
        keep_alive = marker_check.exit_code == 0
        if keep_alive:
            await sandbox.exec("rm", ["-f", KEEP_ALIVE_MARKER])

        wip_commit_message = f"WIP: {profile.name} sandbox session ({args.branch})"
        patch_text = await collect_sandbox_patches(
            sandbox, target_workdir, base_sha, wip_commit_message
        )

        if keep_alive and patch_text is not None:
            # re-pin so the next round only collects commits made after this transplant
            head_result = await sandbox.exec("git", ["rev-parse", "HEAD"], cwd=target_workdir)
            if head_result.exit_code != 0:
                sys.exit(f"failed to read sandbox HEAD: {head_result.stderr_text}")
            pin_result = await sandbox.exec(
                "sh", ["-c", f"echo {head_result.stdout_text.strip()} > {BASE_SHA_FILE}"]
            )
            if pin_result.exit_code != 0:
                sys.exit(f"failed to re-pin base sha in sandbox: {pin_result.stderr_text}")
    finally:
        if not keep_alive:
            await sandbox.destroy()

    if patch_text is not None:
        apply_patches_to_worktree(worktree_path, patch_text)
        print(
            f"> transplanted sandbox commits onto {worktree_path} (branch {args.branch})",
            file=sys.stderr,
        )
    else:
        print(
            "> no changes detected in sandbox, removing empty worktree", file=sys.stderr
        )
        remove_empty_worktree(workdir, worktree_path, args.branch)

    if keep_alive:
        print(
            f"> sandbox left running as '{sandbox_name}' - rerun the same command to resume",
            file=sys.stderr,
        )

    sys.exit(exit_code)


if __name__ == "__main__":
    asyncio.run(main())

