class FatalError(Exception):
    """Unrecoverable failure; reported once by main()."""


def log(msg: str) -> None:
    if _verbose:
        print(msg, file=sys.stderr)


def check_result(result, action: str) -> None:
    if result.exit_code != 0:
        raise FatalError(f"failed to {action}: {result.stderr_text}")


def run_host(
    cmd: list[str], cwd: str | None = None
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, check=False)


def check_process(result: subprocess.CompletedProcess[str], action: str) -> None:
    if result.returncode != 0:
        raise FatalError(f"failed to {action}: {result.stderr}")


