import argparse
import asyncio
import hashlib
import os
import subprocess
import sys
import tempfile
from dataclasses import dataclass

from microsandbox import (
    Action,
    Destination,
    Network,
    NetworkPolicy,
    Patch,
    Rule,
    Sandbox,
    SandboxNotFoundError,
    SandboxStatus,
    Secret,
    Volume,
